<?xml version="1.0" encoding="UTF-8"?>
<!--
  L2 UC3 deliverable: production-shaped Spring Boot + Spring Security
  wrapper around secure-banking-core's real JWT/authorization/masking/
  tool-calling logic.

  Same buildability caveat as every Spring Boot module in this submission:
  Maven Central is blocked in this sandbox, so this could not be
  `mvn compile`-verified here. secure-banking-core (what this wraps) WAS
  actually compiled and run with plain javac/java, including real
  cryptographic JWT signing/verification -- see secure-banking-core/ and
  ../reports/. Run `mvn clean verify` on a machine with real internet
  access before first deployment.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.retailco.bankrag</groupId>
    <artifactId>secure-banking-service</artifactId>
    <version>0.1.0</version>
    <name>secure-banking-service</name>
    <description>
        L2 UC3 (Secure Banking Data Integration) production-shaped REST API.
        JWT-authenticated endpoints for account balance, transaction
        history, and loan outstanding, backed by the same JwtService /
        BankingToolService / PiiMasking classes that were actually compiled
        and run in secure-banking-core (see ../reports/).
    </description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          Note: this service uses its OWN pure-JDK JwtService (copied from
          secure-banking-core -- see this module's source tree) rather than
          io.jsonwebtoken:jjwt-*, specifically so the exact same
          sign/verify logic that was actually compiled and run in
          secure-banking-core is what backs this API, instead of a
          different, unverified implementation. A real deployment could
          equally standardize on jjwt (a mature, widely-used library) once
          Maven Central is reachable -- either is a reasonable production
          choice; this submission's constraint drove the decision, not a
          claim that a hand-rolled JWT implementation is generally
          preferable to jjwt.
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
