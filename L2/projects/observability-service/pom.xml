<?xml version="1.0" encoding="UTF-8"?>
<!--
  L2 UC4 deliverable: production-shaped Spring Boot wrapper adding
  caching, metrics, and cost tracking around L2/UC2's rag-assistant-core
  pipeline. Same Maven-Central-blocked buildability caveat as every Spring
  Boot module in this submission -- see observability-core/ and
  ../reports/ for what was actually compiled and run.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.retailco.bankrag</groupId>
    <artifactId>observability-service</artifactId>
    <version>0.1.0</version>
    <name>observability-service</name>
    <description>
        L2 UC4 (Intelligence Maturity &amp; Optimization) production-shaped
        REST wrapper. Adds POST /api/v1/observability/ask (cached,
        metered, cost-tracked) and GET /api/v1/observability/metrics on
        top of L2/UC2's already-verified rag-assistant-core pipeline.
    </description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
