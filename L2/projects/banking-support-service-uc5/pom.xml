<?xml version="1.0" encoding="UTF-8"?>
<!--
  L2 UC5 deliverable: "Fully functional AI Banking Support System" as a
  single Spring Boot application -- the final integration point of every
  Spring Boot module built across L2/UC1-UC4. Same Maven-Central-blocked
  buildability caveat as every Spring Boot module in this submission --
  see banking-support-core/ and ../reports/ for what was actually compiled
  and run (including this exact integration, in pure JDK).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.retailco.bankrag</groupId>
    <artifactId>banking-support-service</artifactId>
    <version>0.1.0</version>
    <name>banking-support-service</name>
    <description>
        L2 UC5: Final Integrated Banking RAG System. One Spring Boot
        application exposing a single POST /api/v1/support/ask endpoint
        that routes every request through L2/UC3's IntentClassifier to
        either L2/UC2+UC4's cached, guarded, observed RAG pipeline or
        L2/UC3's JWT-secured, masked live banking data tools.
    </description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
